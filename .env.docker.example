APP_NAME="Absensi MKP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker MySQL - use service name 'db' as host
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=absensi_mkp
# Prefer a dedicated app user (NOT root) - MySQL container refuses MYSQL_USER=root
DB_USERNAME=laravel_user
DB_PASSWORD=secret
# Root password for the mysql container (falls back to DB_PASSWORD if unset).
# Only needed if DB_USERNAME=root; then set DB_PASSWORD to the same value.
DB_ROOT_PASSWORD=secret
# Optional: MySQL init user if you need it different from DB_USERNAME
# (must not be root). Leave unset unless DB_USERNAME is a custom non-root user
# and you need the container to create that user with DB_APP_PASSWORD.
# DB_APP_USER=laravel_user
# DB_APP_PASSWORD=secret

# For production, set:
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# Use strong passwords and set DB_ROOT_PASSWORD differently from DB_PASSWORD
