APP_NAME="Absensi MKP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker MySQL - use service name 'db' as host
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=absensi_mkp
DB_USERNAME=laravel_user
DB_PASSWORD=secret
# Optional: separate root password (falls back to DB_PASSWORD if not set)
DB_ROOT_PASSWORD=secret

# For production, set:
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# Use strong passwords and set DB_ROOT_PASSWORD differently from DB_PASSWORD
